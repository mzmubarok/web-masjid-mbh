generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                      String            @id @default(cuid())
  name                    String
  email                   String            @unique
  passwordHash            String
  roleId                  String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  aboutsCreated           About[]           @relation("AboutCreatedBy")
  aboutsUpdated           About[]           @relation("AboutUpdatedBy")
  auditLogs               AuditLog[]
  donationProgramsCreated DonationProgram[] @relation("DonationProgramCreatedBy")
  donationProgramsUpdated DonationProgram[] @relation("DonationProgramUpdatedBy")
  eventsCreated           Event[]           @relation("EventCreatedBy")
  eventsUpdated           Event[]           @relation("EventUpdatedBy")
  financialReportsCreated FinancialReport[] @relation("FinancialReportCreatedBy")
  financialReportsUpdated FinancialReport[] @relation("FinancialReportUpdatedBy")
  galleryAlbumsCreated    GalleryAlbum[]    @relation("GalleryAlbumCreatedBy")
  galleryAlbumsUpdated    GalleryAlbum[]    @relation("GalleryAlbumUpdatedBy")
  heroesCreated           Hero[]            @relation("HeroCreatedBy")
  heroesUpdated           Hero[]            @relation("HeroUpdatedBy")
  hijriOverridesCreated   HijriOverride[]
  media                   Media[]
  role                    Role              @relation(fields: [roleId], references: [id])

  @@index([roleId])
}

model Media {
  id                      String             @id @default(cuid())
  fileName                String
  storedFileName          String             @unique
  extension               String
  mimeType                String
  fileSize                Int
  width                   Int?
  height                  Int?
  altText                 String?
  title                   String?
  description             String?
  folder                  String?
  storagePath             String
  checksum                String             @unique
  uploadedById            String
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  donationProgramCoverFor DonationProgram[]
  eventFeaturedImageFor   Event[]
  eventCategoryIconFor    EventCategory[]
  financialProgramIconFor FinancialProgram[]
  galleryAlbumCoverFor    GalleryAlbum[]
  galleryPhotoFor         GalleryPhoto[]
  heroBackgroundFor       Hero[]
  uploadedBy              User               @relation(fields: [uploadedById], references: [id])
  siteSeoImageFor         SiteSetting[]      @relation("SiteSettingSeoImage")
  siteFaviconFor          SiteSetting[]      @relation("SiteSettingFavicon")
  siteLogoDarkFor         SiteSetting[]      @relation("SiteSettingLogoDark")
  siteLogoFor             SiteSetting[]      @relation("SiteSettingLogo")
  siteQrisImageFor        SiteSetting[]      @relation("SiteSettingQrisImage")
  socialMediaIconFor      SocialMedia[]
  taglineIconFor          Tagline[]

  @@index([uploadedById])
  @@index([mimeType])
  @@index([createdAt])
  @@index([folder])
}

model SiteSetting {
  id                 String   @id @default(cuid())
  siteName           String
  siteTagline        String?
  siteDescription    String?
  language           String
  timezone           String
  logoId             String?
  logoDarkId         String?
  faviconId          String?
  defaultSeoImageId  String?
  metaTitle          String
  metaDescription    String
  metaKeywords       String?
  canonicalUrl       String?
  ogTitle            String?
  ogDescription      String?
  twitterCard        String?
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  copyrightText      String
  footerDescription  String?
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  qrisImageId        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  defaultSeoImage    Media?   @relation("SiteSettingSeoImage", fields: [defaultSeoImageId], references: [id])
  favicon            Media?   @relation("SiteSettingFavicon", fields: [faviconId], references: [id])
  logoDark           Media?   @relation("SiteSettingLogoDark", fields: [logoDarkId], references: [id])
  logo               Media?   @relation("SiteSettingLogo", fields: [logoId], references: [id])
  qrisImage          Media?   @relation("SiteSettingQrisImage", fields: [qrisImageId], references: [id])
}

model ContactLocation {
  id                       String   @id @default(cuid())
  mosqueName               String
  shortDescription         String?
  address                  String
  district                 String?
  city                     String
  province                 String
  postalCode               String?
  latitude                 Decimal?
  longitude                Decimal?
  googleMapsUrl            String?
  phone                    String?
  whatsapp                 String?
  email                    String?
  openingTime              String
  closingTime              String
  operatingNotes           String?
  ablutionArea             Boolean
  restroom                 Boolean
  navigationTitle          String?
  directionNotes           String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  parkingDescription       String?
  accessibilityDescription String?
  googleMapsEmbedUrl       String?
}

model SocialMedia {
  id           String            @id @default(cuid())
  platform     String            @unique
  url          String
  iconId       String?
  displayOrder Int
  isActive     Boolean
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  icon         Media?            @relation(fields: [iconId], references: [id])
  posts        SocialMediaPost[]

  @@index([displayOrder])
  @@index([isActive])
}

model SocialMediaPost {
  id            String      @id @default(cuid())
  socialMediaId String
  postUrl       String
  displayOrder  Int
  isPublished   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  socialMedia   SocialMedia @relation(fields: [socialMediaId], references: [id], onDelete: Cascade)

  @@index([socialMediaId])
  @@index([displayOrder])
  @@index([isPublished])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  module      String
  action      String
  entityType  String
  entityId    String
  description String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model Hero {
  id                String    @id @default(cuid())
  title             String
  subtitle          String?
  backgroundImageId String?
  isPublished       Boolean   @default(false)
  publishedAt       DateTime?
  createdById       String
  updatedById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  backgroundImage   Media?    @relation(fields: [backgroundImageId], references: [id])
  createdBy         User      @relation("HeroCreatedBy", fields: [createdById], references: [id])
  updatedBy         User      @relation("HeroUpdatedBy", fields: [updatedById], references: [id])

  @@index([isPublished])
  @@index([publishedAt])
}

model About {
  id               String    @id @default(cuid())
  title            String
  introduction     String
  history          String
  vision           String
  mission          String
  aboutPageContent String?
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  createdById      String
  updatedById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        User      @relation("AboutCreatedBy", fields: [createdById], references: [id])
  updatedBy        User      @relation("AboutUpdatedBy", fields: [updatedById], references: [id])
  taglines         Tagline[]

  @@index([isPublished])
  @@index([publishedAt])
}

model Tagline {
  id          String   @id @default(cuid())
  aboutId     String
  title       String
  description String
  iconId      String?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  about       About    @relation(fields: [aboutId], references: [id])
  icon        Media?   @relation(fields: [iconId], references: [id])

  @@unique([aboutId, sortOrder])
  @@index([sortOrder])
}

model EventCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?
  iconId    String?
  sortOrder Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
  icon      Media?   @relation(fields: [iconId], references: [id])
}

model Event {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  excerpt         String
  description     String
  featuredImageId String?
  categoryId      String
  location        String
  startDate       DateTime
  endDate         DateTime?
  startTime       String
  endTime         String?
  isFeatured      Boolean        @default(false)
  isPublished     Boolean        @default(false)
  publishedAt     DateTime?
  createdById     String
  updatedById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        EventCategory  @relation(fields: [categoryId], references: [id])
  createdBy       User           @relation("EventCreatedBy", fields: [createdById], references: [id])
  featuredImage   Media?         @relation(fields: [featuredImageId], references: [id])
  updatedBy       User           @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  galleryAlbums   GalleryAlbum[]

  @@index([startDate])
  @@index([categoryId])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([isFeatured])
}

model GalleryAlbum {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  description  String?
  coverImageId String?
  eventId      String?
  eventDate    DateTime?
  isFeatured   Boolean        @default(false)
  isPublished  Boolean        @default(false)
  publishedAt  DateTime?
  sortOrder    Int
  createdById  String
  updatedById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  coverImage   Media?         @relation(fields: [coverImageId], references: [id])
  createdBy    User           @relation("GalleryAlbumCreatedBy", fields: [createdById], references: [id])
  event        Event?         @relation(fields: [eventId], references: [id])
  updatedBy    User           @relation("GalleryAlbumUpdatedBy", fields: [updatedById], references: [id])
  photos       GalleryPhoto[]

  @@index([eventId])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([eventDate])
  @@index([sortOrder])
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  mediaId   String
  caption   String?
  altText   String?
  sortOrder Int
  createdAt DateTime     @default(now())
  album     GalleryAlbum @relation(fields: [albumId], references: [id])
  media     Media        @relation(fields: [mediaId], references: [id])

  @@index([albumId])
  @@index([mediaId])
  @@index([sortOrder])
}

model PrayerSetting {
  id                String   @id @default(cuid())
  mosqueName        String
  latitude          Decimal
  longitude         Decimal
  timezone          String
  calculationMethod String
  madhab            String
  isAutomatic       Boolean  @default(true)
  fajrAngle         Decimal?
  ishaAngle         Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  calculationMode   String   @default("LFNU")
  fajrIhtiyath      Int      @default(0)
  sunriseIhtiyath   Int      @default(0)
  dhuhrIhtiyath     Int      @default(0)
  asrIhtiyath       Int      @default(0)
  maghribIhtiyath   Int      @default(0)
  ishaIhtiyath      Int      @default(0)
}

model HijriOverride {
  id            String   @id @default(cuid())
  gregorianDate DateTime @unique
  hijriDay      Int
  hijriMonth    Int
  hijriYear     Int
  notes         String?
  source        String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User     @relation(fields: [createdById], references: [id])
}

model FinancialProgram {
  id             String            @id @default(cuid())
  name           String            @unique
  slug           String            @unique
  description    String?
  iconId         String?
  color          String?
  showOnHomepage Boolean           @default(true)
  displayOrder   Int
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  icon           Media?            @relation(fields: [iconId], references: [id])
  reports        FinancialReport[]

  @@index([displayOrder])
  @@index([isActive])
  @@index([showOnHomepage])
}

model FinancialReport {
  id             String           @id @default(cuid())
  programId      String
  reportMonth    Int
  reportYear     Int
  dataSource     String           @default("manual")
  totalFund      Decimal          @default(0)
  monthlyIncome  Decimal          @default(0)
  monthlyExpense Decimal          @default(0)
  currentBalance Decimal          @default(0)
  spreadsheetUrl String?
  viewerUrl      String?
  notes          String?
  isPublished    Boolean          @default(false)
  publishedAt    DateTime?
  createdById    String
  updatedById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      User             @relation("FinancialReportCreatedBy", fields: [createdById], references: [id])
  program        FinancialProgram @relation(fields: [programId], references: [id])
  updatedBy      User             @relation("FinancialReportUpdatedBy", fields: [updatedById], references: [id])

  @@unique([programId, reportMonth, reportYear])
  @@index([reportYear])
  @@index([reportMonth])
  @@index([isPublished])
  @@index([publishedAt])
}

model FinancialSyncRun {
  id           String    @id @default(cuid())
  status       String
  triggeredBy  String
  created      Int       @default(0)
  updated      Int       @default(0)
  skipped      Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([startedAt])
  @@index([status])
}

model DonationProgram {
  id                   String    @id @default(cuid())
  name                 String    @unique
  slug                 String    @unique
  shortDescription     String?
  content              String?
  donationInstructions String?
  coverImageId         String?
  displayOrder         Int
  isFeatured           Boolean   @default(false)
  isPublished          Boolean   @default(false)
  publishedAt          DateTime?
  createdById          String
  updatedById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  coverImage           Media?    @relation(fields: [coverImageId], references: [id])
  createdBy            User      @relation("DonationProgramCreatedBy", fields: [createdById], references: [id])
  updatedBy            User      @relation("DonationProgramUpdatedBy", fields: [updatedById], references: [id])

  @@index([displayOrder])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([isFeatured])
}
